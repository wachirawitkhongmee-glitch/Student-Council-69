# =====================================================
# Student Council (SC 69) - Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.
# =====================================================

# Admin Account Credentials Configuration
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_secure_password_here

# Frontend Public API Keys (Set HTTP Referrer Restrictions in provider console)
VITE_PUBLIC_API_KEY=your_public_api_key
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend API Endpoint URL Proxy
API_BASE_URL=/api

# IMPORTANT: Never commit actual secret keys or '.env' file to GitHub.
